POSTGRES_PASSWORD=replace-with-local-password
ADMIN_DATABASE_URL=postgresql://tax_admin:replace-with-local-password@127.0.0.1:54337/tax_harness
DATABASE_URL=postgresql://tax_app:replace-with-local-password@127.0.0.1:54337/tax_harness
TEST_DATABASE_URL=postgresql://tax_app:replace-with-local-password@127.0.0.1:54337/tax_harness_test
INGEST_DATABASE_URL=
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
MODEL_CONTEXT_LIMIT=0
MODEL_EXTRA_BODY={}
# Optional public search. Sends only requested public search terms to Exa.
PUBLIC_WEB_ENABLED=false
TOKEN_COUNTER=conservative_utf8
OUTPUT_RESERVE=2048
SESSION_CONTEXT_WINDOW=100000
# Optional additional input cap; existing explicitly configured values remain effective.
# INPUT_BUDGET=16000
MAX_MODEL_STEPS=8
MAX_TOOL_CALLS=16
TURN_TIMEOUT=180
DEMO_MODE=true
DEPLOYMENT_MODE=demo
LOGIN_TTL_SECONDS=43200
REQUESTS_PER_MINUTE=60
MAX_PENDING_PER_USER=20
MAX_PENDING_GLOBAL=200
MAX_ACTIVE_RUNS=4
MAX_RETRIEVAL_REQUESTS=4
JSON_MAX_BYTES=1048576
STATEMENT_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=3000
# 默认正常运行策略。消融比较脚本在独立数据库按策略覆盖这些值。
SUMMARY_EVIDENCE_BUDGET=3000
# Legacy compatibility only; conversation-log projection ignores this turn count.
CONTEXT_RECENT_TURNS=12
CONTEXT_USE_SUMMARY=true
CONTEXT_AUTO_COMPACT=true
CONTEXT_HISTORY_SEARCH=true

# Chat-only semantics: off until quality and access gates pass.
CONVERSATION_SEMANTIC_MODE=off
